{
  "name": "workbuddy-theme-forge",
  "version": "0.2.0",
  "private": true,
  "description": "A reversible, non-invasive WorkBuddy theme engine over local Chromium CDP.",
  "type": "module",
  "bin": {
    "wb-theme": "./src/cli.mjs"
  },
  "scripts": {
    "start:editor": "node apps/editor/server.mjs --open",
    "start:control": "node src/cli.mjs serve --open",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "node --check src/cli.mjs && node --check apps/editor/server.mjs && node --check src/theme-store.mjs && node --check src/injector.mjs",
    "doctor": "node src/cli.mjs doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "css-tree": "^3.1.0",
    "image-size": "^2.0.2",
    "semver": "^7.7.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "ws": "^8.21.1"
  }
}
